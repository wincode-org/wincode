# Spike A1: gen_snapshot for iOS arm64, built on a Linux x64 host.
# A real iOS target configuration (target_os = "ios"); only the host-toolchain
# gen_snapshot is built. BUILDCONFIG.gn is patched by build.sh so that, on a
# Linux host, the iOS configuration uses the Linux clang toolchains and never
# loads //build/toolchain/mac (which asserts host_os == "mac").

# Target: what the generated code runs on (same as the engine's iOS release build).
target_os = "ios"
target_cpu = "arm64"
dart_target_arch = "arm64"
use_simulator = false

# Unused: set only so build/config/ios/ios_sdk.gni skips find_sdk.py (macOS-only).
# Nothing is compiled for the iOS toolchain.
ios_sdk_path = "/nonexistent/iPhoneOS.sdk"

# Product (= Flutter "release") gen_snapshot. Dart's own product mode sets these four.
is_debug = false
is_release = false
is_product = true
dart_debug = false
dart_runtime_mode = "release"   # engine: runtime_mode release -> dart_runtime_mode release -> PRODUCT

# Mirrors engine/src/flutter/tools/gn for an iOS release build.
dart_use_compressed_pointers = false      # only enabled for android (tools/gn: "iOS is excluded")
dart_default_optimization_level = "2"     # set for target_os android/ios
dart_component_kind = "static_library"
dart_lib_export_symbols = false
dart_dynamic_modules = false              # default; only set with --dart-dynamic-modules
dart_sdk_verification_hash = "04bcd1036c" # engine uses dart_version[:10]; matches the kernel SDK hash in app.dill
dart_version_git_info = true
exclude_kernel_service = false

is_clang = true
